rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Strict NCCU Member Verification Gate (@g.nccu.edu.tw OR @nccu.edu.tw + verified email)
    function isNccuStudent() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-zA-Z0-9._%+\\-]+@(g\\.)?nccu\\.edu\\.tw$');
    }

    function isAdmin() {
      return isNccuStudent()
        && request.auth.token.email in [
          '112501064@g.nccu.edu.tw',
          'admin@nccu.edu.tw',
          'admin@g.nccu.edu.tw',
          'ncculoop.admin@nccu.edu.tw'
        ];
    }

    function isOwner(userId) {
      return isNccuStudent() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'nccuEmail', 'nickname', 'isVerifiedStudent', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'nccuEmail', 'studentId', 'nickname', 'realName', 'biologicalSex',
          'department', 'year', 'dormLocation', 'bio', 'gender', 'zone',
          'canTutorSubjects', 'subscribedTags', 'trustScore', 'helpCount',
          'completedTasks', 'isVerifiedStudent', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.nccuEmail is string
        && data.nccuEmail.size() <= 128
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 64
        && (!('realName' in data) || (data.realName is string && data.realName.size() <= 64))
        && (!('biologicalSex' in data) || (data.biologicalSex in ['female', 'male']))
        && data.isVerifiedStudent is bool
        && data.isVerifiedStudent == true
        && data.updatedAt is timestamp
        && (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 64))
        && (!('department' in data) || (data.department is string && data.department.size() <= 64))
        && (!('year' in data) || (data.year is string && data.year.size() <= 32))
        && (!('dormLocation' in data) || (data.dormLocation is string && data.dormLocation.size() <= 64))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('gender' in data) || (data.gender in ['female', 'male', 'undisclosed', 'other']))
        && (!('zone' in data) || (data.zone in ['downhill', 'uphill', 'dorms', 'off_campus']))
        && (!('canTutorSubjects' in data) || (data.canTutorSubjects is list && data.canTutorSubjects.size() <= 30 && (data.canTutorSubjects.size() == 0 || data.canTutorSubjects[0] is string)))
        && (!('subscribedTags' in data) || (data.subscribedTags is list && data.subscribedTags.size() <= 30 && (data.subscribedTags.size() == 0 || data.subscribedTags[0] is string)))
        && (!('trustScore' in data) || (data.trustScore is number && data.trustScore >= 0 && data.trustScore <= 100))
        && (!('helpCount' in data) || (data.helpCount is number && data.helpCount >= 0 && data.helpCount <= 100000))
        && (!('completedTasks' in data) || (data.completedTasks is number && data.completedTasks >= 0 && data.completedTasks <= 100000));
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'nickname', 'trustScore', 'helpCount', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'nickname', 'biologicalSex', 'department', 'year', 'dormLocation',
          'bio', 'zone', 'canTutorSubjects', 'trustScore', 'helpCount', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 64
        && (!('biologicalSex' in data) || (data.biologicalSex in ['female', 'male']))
        && (!('department' in data) || (data.department is string && data.department.size() <= 64))
        && (!('year' in data) || (data.year is string && data.year.size() <= 32))
        && (!('dormLocation' in data) || (data.dormLocation is string && data.dormLocation.size() <= 64))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('zone' in data) || (data.zone in ['downhill', 'uphill', 'dorms', 'off_campus']))
        && (!('canTutorSubjects' in data) || (data.canTutorSubjects is list && data.canTutorSubjects.size() <= 30 && (data.canTutorSubjects.size() == 0 || data.canTutorSubjects[0] is string)))
        && data.trustScore is number && data.trustScore >= 0 && data.trustScore <= 100
        && data.helpCount is number && data.helpCount >= 0 && data.helpCount <= 100000
        && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll([
          'title', 'description', 'category', 'location', 'price',
          'paymentMethod', 'isAnonymous', 'creatorUid', 'creatorName',
          'creatorEmail', 'status', 'createdAt', 'updatedAt', 'expireAt'
        ])
        && data.keys().hasOnly([
          'title', 'titleEn', 'description', 'descriptionEn', 'category',
          'location', 'locationZone', 'locationLat', 'locationLng',
          'price', 'paymentMethod', 'paymentDirection', 'paymentNote', 'payerRole',
          'quantity', 'remainingQuantity', 'totalQuota',
          'isAnonymous', 'isFemaleDormOnly', 'femaleOnlyRecommended',
          'tags', 'creatorUid', 'creatorName', 'creatorRealName', 'creatorEmail', 'creatorTrustScore',
          'status', 'timeOption', 'remainingMinutes', 'expireAt', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 160))
        && data.description is string && data.description.size() <= 2000
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 2000))
        && data.category in ['leftovers', 'emergency', 'traffic', 'marketplace', 'rental', 'tutor', 'skill', 'group_buy']
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 100
        && (!('locationZone' in data) || (data.locationZone in ['downhill', 'uphill', 'dorms', 'off_campus']))
        && (!('locationLat' in data) || data.locationLat is number)
        && (!('locationLng' in data) || data.locationLng is number)
        && data.price is number && data.price >= 0 && data.price <= 100000
        && data.paymentMethod in ['cash_meetup', 'pre_transfer', 'free_aid']
        && (!('paymentDirection' in data) || (data.paymentDirection in ['creator_pays', 'accepter_pays', 'free']))
        && (!('paymentNote' in data) || (data.paymentNote is string && data.paymentNote.size() <= 200))
        && (!('payerRole' in data) || (data.payerRole in ['creator', 'fulfiller']))
        && (!('quantity' in data) || (data.quantity is number && data.quantity >= 0 && data.quantity <= 20))
        && (!('remainingQuantity' in data) || (data.remainingQuantity is number && data.remainingQuantity >= 0 && data.remainingQuantity <= 20))
        && (!('totalQuota' in data) || (data.totalQuota is number && data.totalQuota >= 1 && data.totalQuota <= 20))
        && data.isAnonymous is bool
        && (!('isFemaleDormOnly' in data) || (data.isFemaleDormOnly is bool && (data.isFemaleDormOnly == false || data.isAnonymous == false)))
        && (!('femaleOnlyRecommended' in data) || data.femaleOnlyRecommended is bool)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)))
        && isValidId(data.creatorUid)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 64
        && (!('creatorRealName' in data) || (data.creatorRealName is string && data.creatorRealName.size() <= 64))
        && data.creatorEmail is string && data.creatorEmail.size() <= 128
        && (!('creatorTrustScore' in data) || (data.creatorTrustScore is number && data.creatorTrustScore >= 0 && data.creatorTrustScore <= 100))
        && data.status in ['open', 'in_progress', 'completed', 'closed', 'expired', 'cancelled']
        && (!('timeOption' in data) || (data.timeOption is string && data.timeOption.size() <= 32))
        && (!('remainingMinutes' in data) || (data.remainingMinutes is number && data.remainingMinutes >= 0 && data.remainingMinutes <= 10080))
        && data.expireAt is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'taskId', 'taskTitle', 'taskLocation', 'taskPrice', 'paymentMethod',
          'creatorUid', 'creatorName', 'creatorAnonymous',
          'accepterUid', 'accepterName', 'accepterAnonymous',
          'status', 'creatorPaidConfirmed', 'accepterPaidConfirmed',
          'creatorDoneConfirmed', 'accepterDoneConfirmed',
          'revealCreator', 'revealAccepter', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'taskId', 'taskCategory', 'taskTitle', 'taskTitleEn', 'taskLocation', 'taskLocationEn',
          'taskPrice', 'paymentMethod', 'paymentDirection', 'paymentNote', 'payerRole', 'taskExpireAt',
          'isFemaleDormOnly',
          'creatorUid', 'creatorName', 'creatorRealName', 'creatorAnonymous', 'creatorAnonAlias',
          'accepterUid', 'accepterName', 'accepterRealName', 'accepterAnonymous', 'accepterAnonAlias',
          'status', 'creatorPaidConfirmed', 'accepterPaidConfirmed',
          'creatorDoneConfirmed', 'accepterDoneConfirmed',
          'revealCreator', 'revealAccepter', 'completedAtMs', 'disputeReason', 'disputedByUid',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.taskId)
        && (!('taskCategory' in data) || (data.taskCategory in ['leftovers', 'emergency', 'traffic', 'marketplace', 'rental', 'tutor', 'skill', 'group_buy']))
        && data.taskTitle is string && data.taskTitle.size() >= 1 && data.taskTitle.size() <= 160
        && (!('taskTitleEn' in data) || (data.taskTitleEn is string && data.taskTitleEn.size() <= 160))
        && data.taskLocation is string && data.taskLocation.size() >= 1 && data.taskLocation.size() <= 100
        && (!('taskLocationEn' in data) || (data.taskLocationEn is string && data.taskLocationEn.size() <= 100))
        && data.taskPrice is number && data.taskPrice >= 0 && data.taskPrice <= 100000
        && data.paymentMethod in ['cash_meetup', 'pre_transfer', 'free_aid']
        && (!('paymentDirection' in data) || (data.paymentDirection in ['creator_pays', 'accepter_pays', 'free']))
        && (!('paymentNote' in data) || (data.paymentNote is string && data.paymentNote.size() <= 200))
        && (!('payerRole' in data) || (data.payerRole in ['creator', 'fulfiller']))
        && (!('taskExpireAt' in data) || data.taskExpireAt is number)
        && (!('isFemaleDormOnly' in data) || data.isFemaleDormOnly is bool)
        && isValidId(data.creatorUid)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 64
        && (!('creatorRealName' in data) || (data.creatorRealName is string && data.creatorRealName.size() <= 64))
        && data.creatorAnonymous is bool
        && (!('creatorAnonAlias' in data) || (data.creatorAnonAlias is string && data.creatorAnonAlias.size() <= 64))
        && isValidId(data.accepterUid)
        && data.accepterName is string && data.accepterName.size() >= 1 && data.accepterName.size() <= 64
        && (!('accepterRealName' in data) || (data.accepterRealName is string && data.accepterRealName.size() <= 64))
        && data.accepterAnonymous is bool
        && (!('accepterAnonAlias' in data) || (data.accepterAnonAlias is string && data.accepterAnonAlias.size() <= 64))
        && data.status in ['pending_approval', 'pending_confirm', 'in_progress', 'completed', 'disputed', 'cancelled']
        && data.creatorPaidConfirmed is bool
        && data.accepterPaidConfirmed is bool
        && data.creatorDoneConfirmed is bool
        && data.accepterDoneConfirmed is bool
        && data.revealCreator is bool
        && data.revealAccepter is bool
        && (!('completedAtMs' in data) || data.completedAtMs is number)
        && (!('disputeReason' in data) || (data.disputeReason is string && data.disputeReason.size() <= 1000))
        && (!('disputedByUid' in data) || isValidId(data.disputedByUid))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderMessage(data) {
      return data.keys().hasAll(['text', 'senderUid', 'senderName', 'createdAt'])
        && data.keys().hasOnly(['text', 'senderUid', 'senderName', 'createdAt'])
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && isValidId(data.senderUid)
        && data.senderUid == request.auth.uid
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'orderId', 'taskId', 'taskCategory', 'reviewerUid', 'reviewerName',
          'revieweeUid', 'rating', 'scoreDelta', 'createdAt'
        ])
        && data.keys().hasOnly([
          'orderId', 'taskId', 'taskTitle', 'taskCategory', 'paymentDirection',
          'reviewerUid', 'reviewerName', 'revieweeUid', 'rating', 'tags',
          'comment', 'scoreDelta', 'createdAt'
        ])
        && isValidId(data.orderId)
        && isValidId(data.taskId)
        && (!('taskTitle' in data) || (data.taskTitle is string && data.taskTitle.size() <= 160))
        && data.taskCategory in ['leftovers', 'emergency', 'traffic', 'marketplace', 'rental', 'tutor', 'skill', 'group_buy']
        && (!('paymentDirection' in data) || (data.paymentDirection in ['creator_pays', 'accepter_pays', 'free']))
        && isValidId(data.reviewerUid)
        && data.reviewerUid == request.auth.uid
        && data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 64
        && isValidId(data.revieweeUid)
        && data.revieweeUid != request.auth.uid
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 6 && (data.tags.size() == 0 || data.tags[0] is string)))
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 500))
        && data.scoreDelta in [-3, 0, 1, 2]
        && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['taskId', 'reporterUid', 'reasonCategory', 'description', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'orderId', 'taskId', 'taskTitle', 'reporterUid', 'reporterEmail',
          'reportedUid', 'reportedName', 'reasonCategory', 'description',
          'evidenceUrl', 'status', 'aiSummary', 'adminNote', 'reviewedBy',
          'reviewedAtMs', 'createdAt'
        ])
        && (!('orderId' in data) || isValidId(data.orderId))
        && isValidId(data.taskId)
        && (!('taskTitle' in data) || (data.taskTitle is string && data.taskTitle.size() <= 160))
        && isValidId(data.reporterUid)
        && (!('reporterEmail' in data) || (data.reporterEmail is string && data.reporterEmail.size() <= 128))
        && (!('reportedUid' in data) || isValidId(data.reportedUid))
        && (!('reportedName' in data) || (data.reportedName is string && data.reportedName.size() <= 64))
        && data.reasonCategory in ['no_show', 'money_dispute', 'harassment', 'impersonation', 'malicious_cancel', 'fraud', 'other']
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1000
        && (!('evidenceUrl' in data) || (data.evidenceUrl is string && data.evidenceUrl.size() <= 250000))
        && data.status in ['pending_review', 'submitted', 'frozen_escrow', 'confirmed_violation', 'dismissed']
        && (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 1000))
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && (!('reviewedAtMs' in data) || data.reviewedAtMs is number)
        && data.createdAt is timestamp;
    }

    function isOrderParticipant(orderId) {
      let ord = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return ord.creatorUid == request.auth.uid || ord.accepterUid == request.auth.uid;
    }

    // --- Collection Rules ---

    // 1. Users (PII isolated strictly to account owner + admin review enforcement)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isNccuStudent() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().nccuEmail == request.auth.token.email
        && incoming().updatedAt == request.time
        && (!('trustScore' in incoming()) || incoming().trustScore == 90)
        && (!('helpCount' in incoming()) || incoming().helpCount == 0)
        && (!('completedTasks' in incoming()) || incoming().completedTasks == 0);
      allow update: if isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().nccuEmail == existing().nccuEmail
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nickname', 'realName', 'biologicalSex', 'department', 'year', 'dormLocation', 'zone',
              'bio', 'gender', 'canTutorSubjects', 'subscribedTags',
              'trustScore', 'helpCount', 'completedTasks', 'updatedAt'
            ]))
          ||
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['trustScore', 'updatedAt']))
        );
      allow delete: if false;
    }

    // 1b. Public Profiles (Non-PII campus metrics fetched by UID on mutual reveal)
    match /public_profiles/{userId} {
      allow get: if isValidId(userId) && isNccuStudent();
      allow list: if false;
      allow create, update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidPublicProfile(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 2. Tasks Collection (Parent tasks independent from child order completion)
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isNccuStudent();
      allow list: if isNccuStudent()
        && (resource.data.status == 'open' || resource.data.creatorUid == request.auth.uid || isAdmin());
      allow create: if isValidId(taskId)
        && isNccuStudent()
        && isValidTask(incoming())
        && incoming().creatorUid == request.auth.uid
        && incoming().creatorEmail == request.auth.token.email
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(taskId)
        && isNccuStudent()
        && isValidTask(incoming())
        && !(existing().status in ['completed', 'cancelled'])
        && incoming().creatorUid == existing().creatorUid
        && incoming().creatorEmail == existing().creatorEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().creatorUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'titleEn', 'description', 'descriptionEn',
              'location', 'locationZone', 'locationLat', 'locationLng',
              'price', 'paymentMethod', 'paymentDirection', 'paymentNote', 'payerRole',
              'isFemaleDormOnly', 'femaleOnlyRecommended', 'isAnonymous', 'tags',
              'quantity', 'remainingQuantity', 'totalQuota', 'status',
              'timeOption', 'expireAt', 'remainingMinutes', 'updatedAt'
            ]))
          ||
          (existing().creatorUid != request.auth.uid
            && existing().status == 'open'
            && incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'remainingQuantity', 'status', 'updatedAt']))
        );
      allow delete: if isValidId(taskId) && isNccuStudent() && existing().creatorUid == request.auth.uid;
    }

    // 3. Orders Collection (Child orders & 1-on-1 Chat Rooms)
    match /orders/{orderId} {
      allow get: if isValidId(orderId)
        && isNccuStudent()
        && (existing().creatorUid == request.auth.uid || existing().accepterUid == request.auth.uid || isAdmin());
      allow list: if isNccuStudent()
        && (resource.data.creatorUid == request.auth.uid || resource.data.accepterUid == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId)
        && isNccuStudent()
        && exists(/databases/$(database)/documents/tasks/$(incoming().taskId))
        && isValidOrder(incoming())
        && incoming().accepterUid == request.auth.uid
        && incoming().creatorUid != request.auth.uid
        && incoming().status in ['pending_approval', 'pending_confirm']
        && incoming().creatorPaidConfirmed == false
        && incoming().accepterPaidConfirmed == false
        && incoming().creatorDoneConfirmed == false
        && incoming().accepterDoneConfirmed == false
        && (
          (incoming().revealCreator == false && incoming().revealAccepter == false)
          ||
          (('isFemaleDormOnly' in incoming())
            && incoming().isFemaleDormOnly == true
            && incoming().creatorAnonymous == false
            && incoming().accepterAnonymous == false
            && incoming().revealCreator == true
            && incoming().revealAccepter == true)
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && isNccuStudent()
        && isValidOrder(incoming())
        && !(existing().status in ['completed', 'cancelled'])
        && incoming().taskId == existing().taskId
        && incoming().creatorUid == existing().creatorUid
        && incoming().accepterUid == existing().accepterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().creatorUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'creatorPaidConfirmed', 'creatorDoneConfirmed',
              'revealCreator', 'creatorRealName', 'creatorName',
              'completedAtMs', 'disputeReason', 'disputedByUid', 'updatedAt'
            ]))
          ||
          (existing().accepterUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'accepterPaidConfirmed', 'accepterDoneConfirmed',
              'revealAccepter', 'accepterRealName', 'accepterName',
              'completedAtMs', 'disputeReason', 'disputedByUid', 'updatedAt'
            ]))
        );
      allow delete: if false;

      // 3a. 1-on-1 Chat Messages Subcollection
      match /messages/{messageId} {
        allow get: if isValidId(orderId) && isValidId(messageId) && isNccuStudent() && (isOrderParticipant(orderId) || isAdmin());
        allow list: if isValidId(orderId) && isNccuStudent() && (isOrderParticipant(orderId) || isAdmin());
        allow create: if isValidId(orderId)
          && isValidId(messageId)
          && isNccuStudent()
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && isOrderParticipant(orderId)
          && isValidOrderMessage(incoming())
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // 4. Reviews & Ratings (Non-PII feedback read by verified members for unlocked order review)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && isNccuStudent();
      allow list: if isNccuStudent()
        && (resource.data.revieweeUid is string || resource.data.reviewerUid == request.auth.uid);
      allow create: if isValidId(reviewId)
        && isNccuStudent()
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
        && isOrderParticipant(incoming().orderId)
        && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.status == 'completed'
        && isValidReview(incoming())
        && incoming().reviewerUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 5. Reports & Admin Review Console
    match /reports/{reportId} {
      allow get: if isValidId(reportId)
        && isNccuStudent()
        && (existing().reporterUid == request.auth.uid || existing().reportedUid == request.auth.uid || isAdmin());
      allow list: if isNccuStudent()
        && (resource.data.reporterUid == request.auth.uid || resource.data.reportedUid == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId)
        && isNccuStudent()
        && exists(/databases/$(database)/documents/tasks/$(incoming().taskId))
        && (!('orderId' in incoming()) || exists(/databases/$(database)/documents/orders/$(incoming().orderId)))
        && isValidReport(incoming())
        && incoming().reporterUid == request.auth.uid
        && incoming().status in ['pending_review', 'submitted', 'frozen_escrow']
        && incoming().createdAt == request.time;
      allow update: if isValidId(reportId)
        && isAdmin()
        && isValidReport(incoming())
        && incoming().taskId == existing().taskId
        && incoming().reporterUid == existing().reporterUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'aiSummary', 'adminNote', 'reviewedBy', 'reviewedAtMs'
        ]);
      allow delete: if false;
    }
  }
}
